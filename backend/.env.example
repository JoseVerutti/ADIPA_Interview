# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Proveedor LLM: gemini | groq | none (none = solo extractor heurístico)
LLM_PROVIDER=gemini

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Jev (TypeSafe AI), clasificador para las decisiones de clasificación. Opcional:
# sin key el sistema clasifica solo con reglas. También se acepta TYPESAFE_API_KEY.
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_MIN_CONFIDENCE=0.6
JEV_GATE_THRESHOLD=0.1
JEV_ITEM_THRESHOLD=0.2

# Si el LLM falla (cuota, red, sin key) se usa el extractor basado en reglas.
HEURISTIC_FALLBACK=true
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=2

# Orígenes permitidos (separados por coma). El regex es opcional, p. ej. para previews de Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

MAX_FILE_SIZE_MB=10
MAX_TEXT_CHARS=120000
LOG_LEVEL=INFO
